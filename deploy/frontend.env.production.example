# Copy to /opt/reportcraft/frontend/.env.production
#
# These are read at BUILD time and baked into the bundle — they are not secrets and they are
# visible in the shipped JavaScript. That is fine: the API URL has to be public. (Payment
# gateway settings come from the backend's /payments/config, not from here.)
#
# If VITE_BACKEND_URL is missing the app falls back to http://127.0.0.1:8000 and every
# request from a customer's browser goes nowhere, with no error to explain it. deploy.sh
# refuses to build without it for exactly that reason.

VITE_BACKEND_URL=https://REPLACE_DOMAIN

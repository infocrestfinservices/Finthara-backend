# ── ReportCraft production environment ────────────────────────────────────────
# Copy to /opt/reportcraft/backend/.env and fill in. This file is an EXAMPLE and is safe to
# commit; .env itself is ignored by git and must never be committed or copied off the server.
#
#   cp deploy/env.production.example .env
#   chmod 600 .env
#
# When the Resend domain is verified, only FROM_EMAIL changes here — edit and
# `sudo systemctl restart reportcraft-api`. No redeploy, no rebuild.

# ── deployment ────────────────────────────────────────────────────────────────
# "production" turns off the engine-test routes entirely, guards the API docs, and makes the
# server REFUSE to start with a wildcard CORS. Anything else is treated as a dev machine.
ENV=production

# Comma separated, no trailing slash. These are the sites the browser may call the API from.
CORS_ORIGINS=https://REPLACE_DOMAIN,https://www.REPLACE_DOMAIN

# Where the app lives from a customer's point of view. Password-reset links are built from
# this, so a wrong value sends every reset email to a page that does not exist.
FRONTEND_URL=https://REPLACE_DOMAIN

# ── secrets ───────────────────────────────────────────────────────────────────
# Signs every login token. Generated fresh for this deployment; changing it logs everyone out.
SECRET_KEY=REPLACE_SECRET_KEY

# Browser password for /docs in production. Empty means the docs do not exist at all, which
# is the safe default — no password, no API reference.
DOCS_USER=admin
DOCS_PASSWORD=REPLACE_DOCS_PASSWORD

# ── database ──────────────────────────────────────────────────────────────────
# The SAME Supabase database the app already uses (ap-south-1). Nothing is installed on this
# server and no data moves; the tables already exist.
DATABASE_URL=REPLACE_DATABASE_URL

# ── AI providers ──────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=REPLACE
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=REPLACE

# ── email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=REPLACE
FROM_NAME=ReportCraft AI
# SANDBOX until the domain is verified with Resend. On this sender, Resend only delivers to
# the account owner's own address — so signup and password reset work for you and for nobody
# else. Change to noreply@REPLACE_DOMAIN the day verification lands.
FROM_EMAIL=onboarding@resend.dev

# ── payments ──────────────────────────────────────────────────────────────────
# Cashfree (INR). Start with SANDBOX keys — real cards are not charged. Switch
# CASHFREE_ENV to production and swap in the production keys only after go-live approval.
# The secret key also verifies Cashfree's webhooks; there is no separate webhook secret.
CASHFREE_APP_ID=REPLACE_APP_ID
CASHFREE_SECRET_KEY=REPLACE_SECRET_KEY
CASHFREE_ENV=sandbox
# FRONTEND_URL (above) must be the https site address — Cashfree's return URL is built from it.

# ── invoices ──────────────────────────────────────────────────────────────────
# Printed on every invoice. Invoices are snapshots, so filling these in later does NOT fix
# documents already issued — set them before a real customer pays.
COMPANY_NAME=ReportCraft AI
COMPANY_ADDRESS=REPLACE_REGISTERED_ADDRESS
COMPANY_EMAIL=support@REPLACE_DOMAIN
COMPANY_STATE=REPLACE_STATE
# Empty = not registered for GST, so the document is a Bill of Supply with no tax line.
# Setting a GSTIN here turns it into a Tax Invoice with a tax breakup — no code change.
COMPANY_GSTIN=

# ── LibreOffice ───────────────────────────────────────────────────────────────
# Without this the workbook ships with formulas that were never calculated and PDF returns
# a 503. Installed by setup-server.sh.
LIBREOFFICE_PATH=/usr/bin/soffice
